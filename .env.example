# Supabase env example (safe to commit; the real .env is git-ignored)
# Copy to .env and fill in real values from your Supabase project settings.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# EmailJS — admin notification on new application (optional but recommended).
# Get these from https://dashboard.emailjs.com (free: 200 emails/mo).
# 1. Create an email service (e.g. Gmail) → note the Service ID.
# 2. Create an email template → note the Template ID.
# 3. Copy your Public Key from Account → General.
VITE_EMAILJS_PUBLIC_KEY=YOUR-EMAILJS-PUBLIC-KEY
VITE_EMAILJS_SERVICE_ID=YOUR-EMAILJS-SERVICE-ID
VITE_EMAILJS_TEMPLATE_ID=YOUR-EMAILJS-TEMPLATE-ID
